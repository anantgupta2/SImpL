{
    "preprocess": {
        "enabled": false
    },
    "oat_args": {
        "critic_type": "drgrpo",
        "gpus": 1,
        "num_gpus_per_actor": 1,
        "collocate": true,
        "vllm_gpu_ratio": 0.4,
        "bf16": true,
        "flash_attn": true,
        "gradient_checkpointing": true,
        "ref_offload": true,
        "zero_stage": 2,
        "pretrain": "Qwen/Qwen3-4B-Base",
        "is_instruct": false,
        "learning_rate": 2e-05,
        "num_ppo_epochs": 2,
        "train_split": "train",
        "input_key": "article",
