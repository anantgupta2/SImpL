        "max_save_num": 100,
        "beta": 0.02,
        "max_norm": 0.5,
        "max_sgd_steps": 300,
        "max_step_adjustment": 0.9259,
        "lr_scheduler": "constant",
        "prompt_data": "data/joint-lsat-race/train_2525.jsonl",
        "dataset_name": "lsat-ar"
