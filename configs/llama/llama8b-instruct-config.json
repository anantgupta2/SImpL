{
    "preprocess": {
        "enabled": true,
        "output_dir": "data",
        "dataset_name": "race-c",
        "split": "train",
        "subset": null,
        "seed": 42,
        "num_samples": 1000
    },
    "oat_args": {
        "critic_type": "drgrpo",
        "gpus": 1,
        "num_gpus_per_actor": 1,
        "collocate": true,
        "vllm_gpu_ratio": 0.45,
        "bf16": true,
        "flash_attn": true,
        "gradient_checkpointing": true,
        "ref_offload": true,
        "zero_stage": 2,
        "pretrain": "meta-llama/Llama-3.1-8B",
        "is_instruct": true,
        "learning_rate": 4e-06,
        "num_ppo_epochs": 1,
        "train_split": "train",
        "input_key": "article",
        "output_key": "questions",
        "max_train": 10000,
        "num_prompt_epoch": 4,
        "prompt_max_length": 2048,
        "temperature": 1.0,
        "top_p": 1.0,
        "generate_max_length": 1024,
        "reasoning_num_samples": 8,
        "reasoning_max_tokens": 512,
        "conciseness_penalty_k": 0.1,
        "use_baseline_reward": true,
        "qa_num_samples": 4,
        "qa_train_max_tokens": 512,
        "qa_eval_max_tokens": 256,
        "correct_reward": 1.0,
        "incorrect_reward": 0.0,
        "rollout_batch_size": 8,
        "rollout_batch_size_per_device": 8,
        "train_batch_size": 16,
        "train_batch_size_per_device": 1,
        "save_steps": 251,
        "save_path": "oat-output/simpl",
        "lora_rank": 32,
        "lora_alpha": 64,
        "lora_dropout": 0.05,
        "target_modules": [
            "q_proj",
            "k_proj",
            "v_proj",
            "o_proj",
            "down_proj",
            "up_proj",
            "gate_proj"
        ],
        "use_wb": true,
        "wb_org": "anant-org",
        "wb_project": "SImpL-reasoning",
        "wb_run_name": "llama3.1_8B"
    }
